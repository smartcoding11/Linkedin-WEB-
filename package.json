{
  "name": "linkedin-web-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "LinkedIn web E2E automation (WebdriverIO + Chrome + TypeScript)",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "test:smoke": "wdio run config/wdio.conf.ts --mochaOpts.grep '@smoke'",
    "test:full": "wdio run config/wdio.conf.ts",
    "test:apply": "wdio run config/wdio.conf.ts --spec tests/apply.spec.ts",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "report:open": "allure serve allure-results"
  },
  "dependencies": {
    "@wdio/allure-reporter": "^9.2.14",
    "@wdio/cli": "^9.2.14",
    "@wdio/globals": "^9.2.14",
    "@wdio/local-runner": "^9.2.14",
    "@wdio/mocha-framework": "^9.2.8",
    "@wdio/spec-reporter": "^9.2.14",
    "allure-commandline": "^2.30.0",
    "dotenv": "^16.4.5",
    "selenium-webdriver": "^4.34.0",
    "webdriverio": "^9.2.14"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.9",
    "@types/node": "^20.16.11",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^8.57.1",
    "typescript": "^5.6.3"
  }
}