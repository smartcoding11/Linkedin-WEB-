# LinkedIn Web E2E Configuration
LINKEDIN_EMAIL=your-email@example.com
LINKEDIN_PASSWORD=your-password
LINKEDIN_BASE_URL=https://www.linkedin.com

# Browser
HEADLESS=false
LOG_LEVEL=info

# Apply flow (tests/apply.spec.ts)
# Paste your CV content here (required for the apply spec)
CV_TEXT=
# Comma-separated job titles you identify with
CV_TITLES=developer,engineer
# Optional path to CV file used for upload fields
CV_FILE=
# Safety limits
APPLY_MAX_PAGES=10
APPLY_MIN_SCORE=0.35
# Easy Apply form defaults
APPLY_FIRST_NAME=
APPLY_LAST_NAME=
APPLY_PHONE=
APPLY_CITY=
